# Neon Postgres — pooled connection string (use for the app itself)
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxxxx-pooler.region.aws.neon.tech/apotheka

# Neon direct connection — use only for Alembic migrations
DATABASE_URL_DIRECT=postgresql+asyncpg://user:password@ep-xxxxx.region.aws.neon.tech/apotheka

REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=["http://localhost:3000"]
ENVIRONMENT=development
DEBUG=true
